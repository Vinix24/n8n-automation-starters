{
  "credentials": [
    {
      "name": "MC API Key",
      "type": "httpHeaderAuth",
      "description": "Dashboard/webhook authentication (shared secret header)",
      "data": {
        "name": "X-MC-API-Key",
        "value": "YOUR_MC_API_KEY_HERE"
      }
    },
    {
      "name": "Supabase Service Role",
      "type": "httpHeaderAuth",
      "description": "Supabase service role for server-side writes — set via n8n env SUPABASE_SERVICE_ROLE_KEY",
      "data": {
        "name": "apikey",
        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"
      }
    },
    {
      "name": "Apify Token",
      "type": "httpHeaderAuth",
      "description": "Apify API token for server-side actor runs — set via n8n env APIFY_TOKEN. Rotate at: Apify Console → Settings → Integrations → Reset API token",
      "data": {
        "name": "Authorization",
        "value": "Bearer YOUR_APIFY_TOKEN_HERE"
      }
    }
  ],
  "env_vars": {
    "MC_API_KEY": "Your dashboard API key (shared secret between your dashboard/frontend and n8n)",
    "SUPABASE_URL": "https://<project-ref>.supabase.co",
    "SUPABASE_SERVICE_ROLE_KEY": "eyJ... (service role JWT — keep server-side only)",
    "APIFY_TOKEN": "apify_api_... (Apify personal API token — keep server-side only)",
    "LOCAL_CLAUDE_API_KEY": "Shared secret for local-claude-wrapper.py (set same value in launchctl setenv on MacBook)",
    "LOCAL_CLAUDE_WRAPPER_URL": "http://<tailscale-macbook-ip>:8765 (Tailscale IP of MacBook running local-claude-wrapper)"
  }
}
