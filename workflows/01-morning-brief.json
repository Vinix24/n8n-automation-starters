    {
      "id": "c1d2e3f4-0100-4000-a000-000000000008",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect data from named source nodes\nif (!items || items.length === 0) return [];\nconst contentItems = $('Get Content Stats').all() || [];\nconst leadItems = $('Get Hot Leads').all() || [];\nconst commentItems = $('Get Pending Comments').all() || [];\nconst ideaItems = $('Get Pending Ideas').all() || [];\n\n// Format date in Dutch\nconst today = new Date();\nconst dateStr = today.toLocaleDateString('nl-NL', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  timeZone: 'Europe/Amsterdam'\n});\n\n// --- Content vandaag ---\nconst todayStr = today.toISOString().split('T')[0];\nconst todayContent = contentItems.filter(item => {\n  const d = item.json.planned_date;\n  return d && d.startsWith(todayStr);\n});\n\nlet contentSection = '';\nif (todayContent.length === 0) {\n  contentSection = 'Geen content gepland voor vandaag.';\n} else {\n  contentSection = todayContent.map(item => {\n    const status = item.json.status || 'draft';\n    const statusIcon = status === 'approved' ? '✅' : status === 'review' ? '📝' : '✏️';\n    const platform = item.json.platform || '';\n    const title = item.json.title || 'Zonder titel';\n    return `${statusIcon} [${platform}] ${title} (${status})`;\n  }).join('\\n');\n}\n\n// Upcoming content (next 7 days, excluding today)\nconst nextWeek = new Date(today);\nnextWeek.setDate(nextWeek.getDate() + 7);\nconst upcomingContent = contentItems.filter(item => {\n  const d = item.json.planned_date;\n  return d && d > todayStr && d <= nextWeek.toISOString().split('T')[0];\n});\n\nlet upcomingSection = '';\nif (upcomingContent.length > 0) {\n  upcomingSection = '\\n\\n📅 <b>Komende week:</b>\\n' + upcomingContent.map(item => {\n    const date = item.json.planned_date ? item.json.planned_date.substring(5) : '?';\n    return `• ${date} — ${item.json.title || 'Zonder titel'} (${item.json.status})`;\n  }).join('\\n');\n}\n\n// --- Hot leads ---\nlet leadsSection = '';\nif (leadItems.length === 0) {\n  leadsSection = 'Geen hot leads op dit moment.';\n} else {\n  leadsSection = leadItems.map((item, i) => {\n    const name = item.json.name || 'Onbekend';\n    const score = item.json.lead_score || 0;\n    const lastUpdated = item.json.lead_score_updated_at\n      ? new Date(item.json.lead_score_updated_at).toLocaleDateString('nl-NL', { timeZone: 'Europe/Amsterdam' })\n      : 'n/a';\n    return `${i + 1}. ${name} — score ${score} — ${lastUpdated}`;\n  }).join('\\n');\n}\n\n// --- Pending counts ---\nconst commentCount = commentItems.length;\nconst ideaCount = ideaItems.length;\n\n// --- Actions ---\nconst actions = [];\nif (todayContent.some(item => item.json.status === 'draft')) {\n  actions.push('• Content in draft status afronden en ter review zetten');\n}\nif (todayContent.some(item => item.json.status === 'approved')) {\n  actions.push('• Goedgekeurde content publiceren');\n}\nif (commentCount > 0) {\n  actions.push(`• ${commentCount} comment suggestie${commentCount > 1 ? 's' : ''} reviewen en posten`);\n}\nif (ideaCount > 5) {\n  actions.push(`• Ideeën inbox opschonen (${ideaCount} items)`);\n}\nif (leadItems.length > 0) {\n  const topLead = leadItems[0].json.name || 'Top lead';\n  actions.push(`• Follow-up met ${topLead} (hoogste score)`);\n}\nif (actions.length === 0) {\n  actions.push('• Geen urgente acties — focus op deep work');\n}\n\n// --- Build message ---\nconst message = `☀️ <b>Morning Brief — ${dateStr}</b>\\n\\n📋 <b>Content vandaag:</b>\\n${contentSection}${upcomingSection}\\n\\n🎯 <b>Hot leads (top 5):</b>\\n${leadsSection}\\n\\n💬 <b>Te reviewen:</b>\\n• ${commentCount} comment suggestie${commentCount !== 1 ? 's' : ''} (HN/Reddit)\\n• ${ideaCount} ideeën in inbox\\n\\n⚡ <b>Acties:</b>\\n${actions.join('\\n')}`;\n\nreturn [{ json: { message, contentCount: todayContent.length, leadCount: leadItems.length, commentCount, ideaCount } }];\n"
      }
    },
