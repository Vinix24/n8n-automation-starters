        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏳ On-demand scout gestart voor: <b>{{ $json.topic }}</b>\n\n<i>Budget-check en Apify-run...</i>",
        "additionalFields": {
          "parse_mode": "HTML"
        },
