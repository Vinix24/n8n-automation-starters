            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'chain_2a.pipeline_failed', source: 'n8n-chain-2a', payload: { error: $json.error_message, node: $json.error_node, url: $json.url }, correlation_id: $json.correlation_id, governance_profile: 'business_light', occurred_at: new Date().toISOString(), created_by: 'n8n-chain-2a' }) }}",
        "options": {}
      },
      "continueOnFail": true
    },
    {
      "id": "c2a-0002-0001-0001-000000000003",
      "name": "Telegram Notify Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2400, 720],
      "parameters": {
