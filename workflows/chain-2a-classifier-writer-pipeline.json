        "text": "=⚠️ Chain 2a pipeline mislukt\\n\\nNode: {{ $('Error Aggregator').item.json.error_node }}\\nURL: {{ $('Error Aggregator').item.json.url }}\\nCorrelation: {{ $('Error Aggregator').item.json.correlation_id }}\\n\\nError: {{ $('Error Aggregator').item.json.error_message }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credential",
          "name": "VNX Telegram Bot"
        }
