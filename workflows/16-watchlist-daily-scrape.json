{
  "name": "Watchlist Daily Scrape",
  "nodes": [
    {
      "id": "wd-0001-0001-0001-0001-000000000001",
      "name": "Daily Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "wd-0001-0001-0001-0001-000000000002",
      "name": "Run Watchlist Scrape",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300],
      "parameters": {
        "command": "# TODO: roep hier je eigen watchlist-scraper aan, bv. python3 your_scraper.py --platform=linkedin — moet op stdout JSON printen met key 'scraped' (aantal nieuw gescrapete posts)"
      },
      "retryOnFail": false,
      "onError": "continueErrorOutput"
    },
    {
      "id": "wd-0001-0001-0001-0001-000000000003",
      "name": "Parse Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 240],
      "parameters": {
        "jsCode": "const stdout = ($json.stdout || '').trim();\nconst lines = stdout.split('\\n').filter(l => l.trim().startsWith('{'));\nconst lastJson = lines[lines.length - 1] || '{}';\nlet parsed;\ntry { parsed = JSON.parse(lastJson); } catch { parsed = { scraped: 0, parse_error: stdout.slice(-300) }; }\nreturn [{ json: { scraped: parsed.scraped || 0, raw: stdout.slice(-200), now: new Date().toISOString() } }];"
      }
    },
    {
      "id": "wd-0001-0001-0001-0001-000000000004",
      "name": "Telegram Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 240],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📅 Watchlist scrape: {{ $json.scraped }} posts opgehaald van due-creators",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credential",
          "name": "VNX Telegram Bot"
        }
      }
    },
    {
      "id": "wd-0001-0001-0001-0001-000000000005",
      "name": "Telegram Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 420],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ Watchlist daily scrape FAILED:\n{{ ($json.stderr || $json.error || '').slice(0, 400) }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credential",
          "name": "VNX Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Daily Cron": {
      "main": [[{ "node": "Run Watchlist Scrape", "type": "main", "index": 0 }]]
    },
    "Run Watchlist Scrape": {
      "main": [
        [{ "node": "Parse Output", "type": "main", "index": 0 }],
        [{ "node": "Telegram Error", "type": "main", "index": 0 }]
      ]
    },
    "Parse Output": {
      "main": [[{ "node": "Telegram Success", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "automation-starter" }, { "name": "watchlist" }],
  "pinData": {},
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "n8n"
  }
}
