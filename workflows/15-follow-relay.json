    {
      "id": "flw-0015-0001-0001-0001-000000000003",
      "name": "Unauthorized Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 500],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⛔ Niet geautoriseerd. /follow is alleen beschikbaar voor geautoriseerde gebruikers.",
        "additionalFields": {
          "parse_mode": "HTML"
        },
        "resource": "message"
