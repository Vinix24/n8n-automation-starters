      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏳ Profiel ophalen via Apify...",
        "additionalFields": {
          "parse_mode": "HTML"
        },
        "resource": "message"
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "VNX Telegram Bot"
