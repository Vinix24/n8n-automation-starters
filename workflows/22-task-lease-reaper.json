{
  "name": "22 — Task Lease Reaper",
  "active": true,
  "nodes": [
    {
      "id": "tlr-0022-0001-0001-0001-000000000001",
      "name": "Cron: every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "tlr-0022-0001-0001-0001-000000000002",
      "name": "Call release_expired_task_leases RPC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/release_expired_task_leases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "tlr-0022-0001-0001-0001-000000000003",
      "name": "Any leases released?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-count-gt-zero",
              "leftValue": "={{ $json }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "tlr-0022-0001-0001-0001-000000000004",
      "name": "Log to system.events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 180],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept-Profile",
              "value": "system"
            },
            {
              "name": "Content-Profile",
              "value": "system"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"event_type\": \"task.leases_released\",\n  \"source\": \"n8n-lease-reaper\",\n  \"severity\": \"warn\",\n  \"payload\": {\n    \"count\": {{ $('Call release_expired_task_leases RPC').item.json }},\n    \"triggered_by\": \"cron_5min\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "tlr-0022-0001-0001-0001-000000000005",
      "name": "No-op: no expired leases",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 420],
      "parameters": {}
    },
    {
      "id": "tlr-0022-0001-0001-0001-000000000006",
      "name": "On error: log to system.events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 500],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept-Profile",
              "value": "system"
            },
            {
              "name": "Content-Profile",
              "value": "system"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"event_type\": \"task.lease_reaper_error\",\n  \"source\": \"n8n-lease-reaper\",\n  \"severity\": \"error\",\n  \"payload\": {\n    \"error\": {{ JSON.stringify($json.message || 'unknown') }},\n    \"triggered_by\": \"cron_5min\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron: every 5 minutes": {
      "main": [
        [
          {
            "node": "Call release_expired_task_leases RPC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call release_expired_task_leases RPC": {
      "main": [
        [
          {
            "node": "Any leases released?",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "error": [
        [
          {
            "node": "On error: log to system.events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any leases released?": {
      "main": [
        [
          {
            "node": "Log to system.events",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No-op: no expired leases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": ["automation-starter", "task-fsm", "lease-management"],
  "pinData": {}
}
