          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ startUrls: [{ url: $json.linkedin_url }], maxComments: 200, proxyConfiguration: { useApifyProxy: true } }) }}",
