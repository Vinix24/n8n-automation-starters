{
  "name": "17 — Author Memory Hourly Aggregate",
  "nodes": [
    {
      "id": "am-cron-0001-0001-0001-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 360],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      }
    },
    {
      "id": "am-cron-0001-0001-0001-000000000002",
      "name": "Get 30d Reply History",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 360],
      "parameters": {
        "operation": "getAll",
        "tableId": "comment_history",
        "filters": {
          "conditions": [
            {
              "keyName": "comment_date",
              "keyValue": "={{ $now.minus({ days: 30 }).toISO() }}",
              "condition": "gte"
            }
          ]
        },
        "options": {
          "select": "post_url,commenter_url,commenter_name,likes,comment_date",
          "limit": 10000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "2",
          "name": "VNX Supabase"
        }
      }
    },
    {
      "id": "am-cron-0001-0001-0001-000000000003",
      "name": "Aggregate Per Author",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 360],
      "parameters": {
        "jsCode": "// Aggregate your own replies per author (commenter_url is the author of the\n// post you replied to, since comment_history rows are your own outbound replies\n// stored alongside the parent comment metadata).\nconst rows = $input.all().map(i => i.json);\nconst byAuthor = {};\nfor (const r of rows) {\n  const author = r.commenter_url;\n  if (!author) continue;\n  if (!byAuthor[author]) {\n    byAuthor[author] = {\n      profile_url: author,\n      name: r.commenter_name || null,\n      reply_count_30d: 0,\n      total_likes: 0\n    };\n  }\n  byAuthor[author].reply_count_30d += 1;\n  byAuthor[author].total_likes += (r.likes || 0);\n}\nconst nowIso = new Date().toISOString();\nreturn Object.values(byAuthor).map(v => ({\n  json: {\n    profile_url: v.profile_url,\n    name: v.name,\n    reply_count_30d: v.reply_count_30d,\n    avg_engagement: v.reply_count_30d > 0 ? Math.round((v.total_likes / v.reply_count_30d) * 100) / 100 : null,\n    updated_at: nowIso\n  }\n}));"
      }
    },
    {
      "id": "am-cron-0001-0001-0001-000000000004",
      "name": "Upsert Author Interactions",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [960, 360],
      "parameters": {
        "operation": "upsert",
        "tableId": "author_interactions",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "profile_url", "fieldValue": "={{ $json.profile_url }}" },
            { "fieldId": "name", "fieldValue": "={{ $json.name }}" },
            { "fieldId": "reply_count_30d", "fieldValue": "={{ $json.reply_count_30d }}" },
            { "fieldId": "avg_engagement", "fieldValue": "={{ $json.avg_engagement }}" },
            { "fieldId": "updated_at", "fieldValue": "={{ $json.updated_at }}" }
          ]
        },
        "options": {
          "onConflict": "profile_url"
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "2",
          "name": "VNX Supabase"
        }
      }
    },
    {
      "id": "am-cron-0001-0001-0001-000000000005",
      "name": "Write Cron Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 360],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Content-Profile", "value": "system" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: 'author_memory.cron.completed', source: 'n8n-17-author-memory-cron', actor: 'cron', severity: 'info', payload: { ran_at: new Date().toISOString(), authors_processed: $('Upsert Author Interactions').all().length, governance_profile: 'business_light', domain: 'marketing', target_type: 'table', target_id: 'author_interactions', agent_name: 'author-memory-cron', model: 'n/a' } }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [{ "node": "Get 30d Reply History", "type": "main", "index": 0 }]
      ]
    },
    "Get 30d Reply History": {
      "main": [
        [{ "node": "Aggregate Per Author", "type": "main", "index": 0 }]
      ]
    },
    "Aggregate Per Author": {
      "main": [
        [{ "node": "Upsert Author Interactions", "type": "main", "index": 0 }]
      ]
    },
    "Upsert Author Interactions": {
      "main": [
        [{ "node": "Write Cron Event", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "tags": ["author-memory", "cron", "pr-v2-051", "pr-v2-053"],
  "versionId": "1.0.1-pr-v2-053"
}
