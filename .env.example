# n8n environment variables — kopieer naar je eigen .env of zet ze als n8n env vars.
# Vul overal je eigen waarden in. Niets hieronder is een echte credential.

# --- Supabase (of vervang door je eigen Postgres/REST-laag) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-jwt>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Telegram bot (maak een bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# --- Apify (voor de LinkedIn-scrape actors) ---
APIFY_TOKEN=<your-apify-api-token>

# --- Eigen LinkedIn-profiel (voor track-relay + self-scout: "is dit mijn eigen comment/post?") ---
OWN_LINKEDIN_URL=https://www.linkedin.com/in/<your-handle>/

# --- Shared-secret voor de dashboard-write-relay en de classifier/writer-pipeline webhook ---
MC_API_KEY=<a-random-shared-secret>

# --- Optioneel: lokale Mac/Tailscale-wrapper healthcheck (13-healthcheck-channels.json) ---
# Laat leeg als je geen lokale wrapper draait — de workflow valt dan terug op de placeholder-URL
# en de healthcheck faalt gewoon netjes (geen crash).
LOCAL_CLAUDE_WRAPPER_URL=http://<your-tailscale-macbook-ip>:8765

# --- Alleen relevant als je de Python-afhankelijke workflows draait (zie README "Python-afhankelijkheid") ---
# Absoluut pad naar de root van je eigen backend-repo, gebruikt door executeCommand-nodes.
MC_REPO_ROOT=/opt/your-backend-repo
